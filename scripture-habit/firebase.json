{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json",
        "ttl": [
            {
                "collectionGroup": "translation_cache",
                "field": "createdAt",
                "state": "ENABLED"
            }
        ]
    },
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "emulators": {
        "auth": {
            "port": 9099,
            "disableWarnings": true,
            "settings": {
                "disableEmailVerification": true
            }
        },
        "firestore": {
            "port": 8080
        },
        "hosting": {
            "port": 5005
        },
        "ui": {
            "enabled": true
        },
        "singleProjectMode": true
    }
}