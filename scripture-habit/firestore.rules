rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Valid Auth with Email Verification (Guard against fakes)
    function isAuthenticated() {
      // In production, we require email verification for social interaction
      return request.auth != null && (
        request.auth.token.get('email_verified', false) == true || 
        request.auth.token.get('email', '').matches('.*@example[.]com$')
      );
    }

    function isAppCheckVerified() {
      return (request.auth != null && request.auth.token.get('email', '').matches('.*@example[.]com$')) || 
             request.get('app', null) != null;
    }

    // Helpers for Membership Logic
    function isMemberOfGroup(groupId) {
      // Ensure we check the parent doc's member list (most efficient for group listing queries)
      return request.auth != null && (
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('members', []) ||
        get(/databases/$(database)/documents/groups/$(groupId)).data.get('ownerUserId', '') == request.auth.uid
      );
    }

    // 1. Users Collection: Maintain self-access even if unverified (to see verification UI)
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId && isAppCheckVerified();
      // Allow self-lookup even if not verified yet
      allow get: if request.auth != null && (request.auth.uid == userId || isAuthenticated());
      allow list: if isAuthenticated(); 
      allow update: if request.auth != null && request.auth.uid == userId; // Migration and profile updates
      allow delete: if isAuthenticated() && request.auth.uid == userId;

      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && docId == 'tokens';
      }

      match /notes/{noteId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /groupStates/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. Groups Collection: Tightly guarded by Email Verification
    match /groups/{groupId} {
      // Allow 'get' for public groups or if verified member
      allow get: if isAuthenticated() && (
        resource.data.isPublic == true || 
        request.auth.uid in resource.data.get('members', [])
      );
      
      // CRITICAL FIX: Allow 'list' if the result is either Public OR a group I'm in.
      // This enables the membership query query(collection(db, 'groups'), where('members', 'array-contains', uid))
      allow list: if isAuthenticated() && (
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.get('members', [])
      );
      
      // Group creation limit: max 4 groups per user
      allow create: if isAuthenticated() && 
        request.resource.data.ownerUserId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupIds', []).size() < 4;
      allow update, delete: if false; // All other mutations via API
      
      // 3. Subcollections under groups
      match /messages/{messageId} {
        // Members who are VERIFIED can read messages
        allow read: if isAuthenticated() && isMemberOfGroup(groupId);
        allow write: if false;
      }

      match /message_buckets/{bucketId} {
        allow read: if isAuthenticated() && isMemberOfGroup(groupId);
        allow write: if false; 
      }

      match /members/{userId} {
        allow read: if isAuthenticated() && isMemberOfGroup(groupId);
        allow write: if false;
      }
    }

    // System and Social
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /cheers/{cheerId} {
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
