rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated and email verified (if using password provider)
    function isAuthenticated() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider != 'password' || 
        request.auth.token.email_verified == true
      );
    }

    // Helper to verify App Check
    function isAppCheckVerified() {
      return request.app != null;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // A user can create their own document upon signup (before email verification)
      allow create: if request.auth != null && request.auth.uid == userId && isAppCheckVerified();

      // A user can read a specific user document (needed for group members list).
      // SECURITY: Only allow reading if it's your own profile, or if you are in a group together.
      allow get: if request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) && 
        request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.get('members', [])
      );
      allow list: if false;

      // A user can update their own document, but only specific fields to prevent mass-assignment.
      allow update: if request.auth != null && request.auth.uid == userId &&
                    isAppCheckVerified() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'nickname', 'stake', 'ward', 'bio', 'photoURL', 'language', 'timeZone', 'lastInteractionAt', 'kickThreshold', 'hasSetKickThreshold'
                    ]) &&
                    (request.resource.data.nickname == null || 
                      (request.resource.data.nickname is string && 
                       request.resource.data.nickname.size() <= 100 && 
                       request.resource.data.nickname.matches('^[^<>]*$'))) &&
                    (request.resource.data.bio == null || 
                      (request.resource.data.bio is string && 
                       request.resource.data.bio.size() <= 1000 && 
                       request.resource.data.bio.matches('^[^<>]*$')));

      // A user can delete their own document.
      allow delete: if request.auth != null && request.auth.uid == userId && isAppCheckVerified();

      // Rules for private user data (e.g. fcmTokens)
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the 'notes' subcollection
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId &&
                           (request.resource == null || request.resource.data.comment.size() <= 10000);
      }

      // Rules for the 'groupStates' subcollection
      match /groupStates/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the 'letters' subcollection
      match /letters/{letterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Rules for the 'groups' collection
    match /groups/{groupId} {
      // GET: Allow reading a specific group if public, or if the user is a member/owner
      allow get: if isAuthenticated() && (
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.get('members', []) ||
        resource.data.get('ownerUserId', '') == request.auth.uid
      );
      
      // LIST: Only allow querying public groups, never all groups unconditionally
      allow list: if request.auth != null && resource.data.isPublic == true;

      // A user can create a group, but they must set themselves as the owner.
      allow create: if isAuthenticated() && isAppCheckVerified() &&
                    request.auth.uid == request.resource.data.ownerUserId &&
                    request.resource.data.name.size() <= 100 &&
                    request.resource.data.description.size() <= 1000 &&
                    // Validate invite code if provided
                    (!('inviteCode' in request.resource.data) || 
                     (request.resource.data.inviteCode is string && 
                      request.resource.data.inviteCode.size() >= 8 && 
                      request.resource.data.inviteCode.size() <= 20)) &&
                    // Validate expiry if provided
                    (!('inviteCodeExpiresAt' in request.resource.data) || 
                     (request.resource.data.inviteCodeExpiresAt is timestamp));
      
      // 更新権限 (Update rules)
      allow update: if isAuthenticated() && 
                    (!('membersCount' in request.resource.data) || request.resource.data.membersCount >= 0) && (
        // A. Owner can change basic info but NOT the ownerUserId directly (protect against lock-out/spoofing)
        // and NOT the global stats which should be handled by API transactions.
        (resource.data.get('ownerUserId', '') == request.auth.uid &&
         request.resource.data.get('ownerUserId', '') == resource.data.ownerUserId &&
         (request.resource.data.name == null || request.resource.data.name.size() <= 100) &&
         (request.resource.data.description == null || request.resource.data.description.size() <= 1000) &&
         // Validate invite code updates
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCode']) || 
          (request.resource.data.inviteCode is string && 
           request.resource.data.inviteCode.size() >= 8 && 
           request.resource.data.inviteCode.size() <= 20)) &&
         // Validate expiry updates
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCodeExpiresAt']) || 
          (request.resource.data.inviteCodeExpiresAt is timestamp))
        ) ||
        // B. Members can ONLY update their OWN activity/read timestamps
        (
          request.auth.uid in resource.data.get('members', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberLastActive', 'memberLastReadAt']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().contains('memberLastActive') ||
            request.resource.data.memberLastActive.diff(resource.data.get('memberLastActive', {})).affectedKeys().hasOnly([request.auth.uid])
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().contains('memberLastReadAt') ||
            request.resource.data.memberLastReadAt.diff(resource.data.get('memberLastReadAt', {})).affectedKeys().hasOnly([request.auth.uid])
          )
        )
      );
      
      // Allow deletion if the user is the owner
      allow delete: if isAuthenticated() && resource.data.get('ownerUserId', '') == request.auth.uid;
      
      // Rules for the 'messages' subcollection
      match /messages/{messageId} {
        // Members and owner can read messages
        allow read: if isAuthenticated() &&
                    (
                      request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('members', []) ||
                      get(/databases/$(database)/documents/groups/$(groupId)).data.get('ownerUserId', '') == request.auth.uid
                    );
                    
        // Members and owner can create messages
        allow create: if isAuthenticated() && isAppCheckVerified() &&
                    (
                      request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('members', []) ||
                      get(/databases/$(database)/documents/groups/$(groupId)).data.get('ownerUserId', '') == request.auth.uid
                    ) &&
                    request.resource.data.text.size() <= 1000 &&
                    request.resource.data.senderId == request.auth.uid &&
                    // SECURITY: Ensure client cannot spoof system messages
                    (!('isSystemMessage' in request.resource.data) || request.resource.data.isSystemMessage == false);
                    
        // Only the sender (or owner) can update/delete messages, 
        // EXCEPT for reactions which any member can update.
        allow update: if isAuthenticated() &&
                      (
                        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('members', []) ||
                        get(/databases/$(database)/documents/groups/$(groupId)).data.get('ownerUserId', '') == request.auth.uid
                      ) &&
                      // SECURITY: System messages can NEVER be updated by users
                      resource.data.get('isSystemMessage', false) == false &&
                      (
                        // Case 1: Sender or Owner updating the message content
                        (
                          (resource.data.senderId == request.auth.uid || get(/databases/$(database)/documents/groups/$(groupId)).data.get('ownerUserId', '') == request.auth.uid) &&
                          // Prevent changing senderId, isSystemMessage, or messageType
                          request.resource.data.senderId == resource.data.senderId &&
                          request.resource.data.get('isSystemMessage', false) == false &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'reactions', 'updatedAt']) &&
                          request.resource.data.text.size() <= 1000
                        ) ||
                        // Case 2: Any member updating ONLY reactions
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                        )
                      );
                      
        allow delete: if isAuthenticated() &&
                      (
                        resource.data.senderId == request.auth.uid ||
                        get(/databases/$(database)/documents/groups/$(groupId)).data.get('ownerUserId', '') == request.auth.uid
                      );
      }
    }

    // Rules for the 'system' collection (Maintenance & Status)
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Rules for the 'cheers' collection
    match /cheers/{cheerId} {
      allow read: if request.auth != null && (
        resource.data.senderUid == request.auth.uid || 
        resource.data.targetUid == request.auth.uid
      );
      allow write: if false;
    }

    // Rules for the 'reports' collection
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false; // Only admins via backend can read/manage
    }
  }
}
