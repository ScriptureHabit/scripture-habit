{
  "name": "scripture-habit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "npm start --prefix backend",
    "build": "tsc -b && vite build && npx tsx scripts/localize-meta.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest src",
    "test:coverage": "vitest run --coverage",
    "test:internal": "node scripts/test-emulated.js \"npx vitest api_internal --maxWorkers=3\"",
    "test:e2e": "node scripts/test-emulated.js \"npx playwright test\"",
    "test:visual": "node scripts/test-emulated.js \"npx playwright test tests/visual.spec.ts\"",
    "test:visual:update": "node scripts/test-emulated.js \"npx playwright test tests/visual.spec.ts --update-snapshots\"",
    "test:e2e:ui": "node scripts/test-emulated.js \"npx playwright test --ui\"",
    "db:seed": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/seed.ts"
  },
  "dependencies": {
    "@iconscout/react-unicons": "^2.2.5",
    "@sentry/node": "^10.49.0",
    "@sentry/react": "^10.32.1",
    "@tanstack/react-query": "^5.67.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.4.3",
    "@vercel/speed-insights": "^1.3.1",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "firebase": "^12.6.0",
    "firebase-tools": "^15.22.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5",
    "sharp": "^0.34.5",
    "vconsole": "^3.15.1",
    "zod": "^4.2.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/browser-chromium": "^1.59.1",
    "@playwright/browser-webkit": "^1.59.1",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.4",
    "axios": "^1.15.0",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.6.0",
    "firebase-admin": "^14.1.0",
    "globals": "^16.5.0",
    "hono": "^4.12.12",
    "jsdom": "^27.3.0",
    "msw": "^2.14.6",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
  ,
  "overrides": {
    "uuid": "11.1.1",
    "tar": "7.5.16",
    "@opentelemetry/core": "2.8.0"
  }
}
