{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "api/api.ts",
    "backend/index.ts",
    "api_internal/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "docs/.vitepress/config.mts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "api/**/*.{ts,js}",
    "backend/**/*.{ts,js}",
    "api_internal/**/*.{ts,js}",
    "scripts/**/*.{ts,js}",
    "tests/**/*.{ts,js}"
  ],
  "ignoreDependencies": [
    "@lhci/cli",
    "@opentelemetry/core",
    "@playwright/browser-chromium",
    "@playwright/browser-webkit",
    "cross-spawn",
    "hono",
    "caniuse-lite",
    "@vitejs/plugin-legacy",
    "workbox-precaching",
    "workbox-routing",
    "workbox-strategies",
    "workbox-expiration",
    "workbox-background-sync"
  ],
  "ignoreBinaries": [
    "netstat",
    "findstr",
    "tasklist",
    "gcloud"
  ]
}
