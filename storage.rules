rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{fileName} {
      // Profile pictures are publicly readable
      allow read: if true;
      // Allow user to upload/update their own profile picture (max 2MB, raster image MIME type only: jpeg/png/webp)
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Allow user to delete their own profile picture
      allow delete: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }
  }
}
