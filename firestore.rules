rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Valid Auth with Email Verification or Anonymous Demo Account
    function isAuthenticated() {
      // In production, we require email verification for social interaction,
      // or anonymous authentication for isolated demo sandbox sessions.
      return request.auth != null && (
        request.auth.token.email_verified == true || 
        request.auth.token.get('email_verified', false) == true ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isAppCheckVerified() {
      return request.appCheck != null;
    }

    // Helpers for Membership Logic
    function isMemberOfGroup(groupId) {
      // Ensure we check the parent doc's member list (most efficient for group listing queries)
      let groupDoc = get(/databases/$(database)/documents/groups/$(groupId));
      return request.auth != null && (
        request.auth.uid in groupDoc.data.get('members', []) ||
        groupDoc.data.get('ownerUserId', '') == request.auth.uid
      );
    }

    // 1. Users Collection: Maintain self-access even if unverified (to see verification UI)
    match /users/{userId} {
      // Enforce strict schema constraints on create to prevent injecting arbitrary/unauthorized fields
      allow create: if request.auth != null && request.auth.uid == userId && isAppCheckVerified()
        && request.resource.data.keys().hasOnly([
             'nickname', 'preferredLanguage', 'stake', 'ward', 'bio', 
             'updatedAt', 'lastActiveAt', 'selectedGroupId', 'groupId', 
             'readCountGoal', 'createdAt', 'language', 'hasCompletedOnboarding',
             'hasSeenWelcomeStory', 'hasSeenTour', 'daysStudiedCount', 'totalNotes', 
             'studiedDates', 'isLevelMigrated', 'fcmTokens', 'hasFcmToken',
             'questCreatedGroup', 'questPostedNote', 'lastRecentGroup', 'uid'
           ])
        && (!request.resource.data.keys().hasAny(['nickname']) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 50));

      // Allow self-lookup even if not verified yet, or verified non-anonymous users
      allow get: if request.auth != null && (
        request.auth.uid == userId || 
        (isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous')
      );
      allow list: if false; 
      
      // Harden profile updates: restrict directly editable keys and enforce nickname string constraints
      // Note: 'email' is intentionally excluded to prevent client-side email spoofing (managed via Auth & backend)
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'nickname', 'preferredLanguage', 'stake', 'ward', 'bio', 
             'updatedAt', 'lastActiveAt', 'selectedGroupId', 'groupId', 
             'readCountGoal', 'createdAt', 'language', 'hasCompletedOnboarding',
             'hasSeenWelcomeStory', 'hasSeenTour', 'daysStudiedCount', 'totalNotes', 
             'studiedDates', 'isLevelMigrated', 'fcmTokens', 'hasFcmToken',
             'questCreatedGroup', 'questPostedNote', 'lastRecentGroup'
           ])
        && (!request.resource.data.keys().hasAny(['nickname']) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 50));

      allow delete: if isAuthenticated() && request.auth.uid == userId;

      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Restrict client writes strictly to 'tokens'. 'account' is reserved for server Admin SDK only.
        allow write: if request.auth != null && request.auth.uid == userId && docId == 'tokens';
      }

      match /notes/{noteId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId
          && (!request.resource.data.keys().hasAny(['content']) || (request.resource.data.content is string && request.resource.data.content.size() <= 10000))
          && !request.resource.data.keys().hasAny(['sharedMessageIds', 'sharedWithGroups']);
        allow update: if isAuthenticated() && request.auth.uid == userId
          && (!request.resource.data.keys().hasAny(['content']) || (request.resource.data.content is string && request.resource.data.content.size() <= 10000))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedMessageIds', 'sharedWithGroups']);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /letters/{letterId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create, update: if isAuthenticated() && request.auth.uid == userId
          && (!request.resource.data.keys().hasAny(['content']) || (request.resource.data.content is string && request.resource.data.content.size() <= 10000));
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /groupStates/{groupId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['readMessageCount', 'lastReadAt', 'lastActiveAt', 'updatedAt'])
          && (!request.resource.data.keys().hasAny(['readMessageCount']) || request.resource.data.readMessageCount is number);
      }
    }
    
    // 2. Groups Collection: Tightly guarded by Email Verification & Sandbox Isolation
    match /groups/{groupId} {
      // Allow 'get' for user's own demo group or verified group members
      allow get: if isAuthenticated() && (
        (resource.data.get('isDemoGroup', false) == true && (
          request.auth.uid in resource.data.get('members', []) ||
          groupId == 'demo-group-' + request.auth.uid ||
          resource.data.get('ownerUserId', '') == request.auth.uid
        )) ||
        request.auth.uid in resource.data.get('members', [])
      );
      
      // Allow 'list' only for groups the caller is a member of.
      allow list: if isAuthenticated() && (
        request.auth.uid in resource.data.get('members', [])
      );
      
      allow create, update, delete: if false; // All mutations via API
      
      // 3. Subcollections under groups
      match /messages/{messageId} {
        // Members who are VERIFIED can read messages
        allow read: if isAuthenticated() && isMemberOfGroup(groupId);
        allow write: if false;
      }

      match /messages_latest/{docId} {
        allow read: if isAuthenticated() && isMemberOfGroup(groupId);
        allow write: if false;
      }

      match /members/{userId} {
        allow read: if isAuthenticated() && isMemberOfGroup(groupId);
        allow write: if false;
      }
    }

    // System status: Public read only for status (maintenance info), not arbitrary wildcard docs
    match /system/status {
      allow read: if true;
      allow write: if false;
    }

    match /cheers/{cheerId} {
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      // Prevent anonymous spam, enforce reporter matching, and restrict allowed payload fields
      allow create: if isAuthenticated() 
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.resource.data.get('reporterId', '') == request.auth.uid || request.resource.data.get('reporterUid', '') == request.auth.uid)
        && request.resource.data.keys().hasOnly([
             'reporterId', 'reporterUid', 'messageId', 'groupId', 'reason', 
             'createdAt', 'text', 'senderId', 'targetId', 'targetType', 'status'
           ])
        && (!request.resource.data.keys().hasAny(['reason']) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 1000))
        && (!request.resource.data.keys().hasAny(['text']) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
      allow read, update, delete: if false;
    }
  }
}
