{
  "name": "scripture-habit",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --project scripture-habit-auth",
    "server": "npm start --prefix backend",
    "build": "npx tsx scripts/extract-scripture-metadata.ts && tsc -b && vite build && npx tsx scripts/localize-meta.ts",
    "lint": "eslint .",
    "check:i18n": "npx tsx api_internal/scripts/check-i18n.ts",
    "check:unused-i18n": "npx tsx scripts/find-unused-i18n-keys.ts",
    "clean:unused-i18n": "npx tsx scripts/clean-unused-i18n-keys.ts",
    "sort:locales": "npx tsx api_internal/scripts/sort-locales.ts",
    "check:messages": "npx tsx api_internal/scripts/check-message-types.ts",
    "check:fcm": "npx tsx api_internal/scripts/check-fcm-usage.ts",
    "check:backend": "npx tsx api_internal/scripts/check-backend-integrity.ts",
    "check:knip": "knip",
    "check:lighthouse": "npm run build && npx tsx scripts/run-lighthouse.ts",
    "report:lighthouse": "npx tsx scripts/show-lighthouse-report.ts",
    "check:all": "npm run check:i18n && npm run check:messages && npm run check:fcm && npm run check:backend && npx tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest src",
    "test:coverage": "vitest run --coverage",
    "test:rules": "node scripts/test-emulated.js \"npx vitest run --config vitest.rules.config.ts\"",
    "test:internal": "node scripts/test-emulated.js \"npx vitest api_internal --maxWorkers=3 --hookTimeout=30000 --testTimeout=30000\"",
    "test:a11y": "node scripts/test-emulated.js \"npx playwright test tests/accessibility.spec.ts\"",
    "test:e2e": "node scripts/test-emulated.js \"npx playwright test\"",
    "test:e2e:ci": "node scripts/test-emulated.js \"npx playwright test --grep-invert visual\"",
    "test:visual": "node scripts/test-emulated.js \"npx playwright test tests/visual.spec.ts\"",
    "test:visual:update": "node scripts/test-emulated.js \"npx playwright test tests/visual.spec.ts --update-snapshots\"",
    "test:e2e:ui": "node scripts/test-emulated.js \"npx playwright test --ui\"",
    "db:seed": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/seed.ts",
    "db:seed-solo": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/seed-solo.ts",
    "db:migrate": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/migrate-data.ts",
    "db:migrate-max-members": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/migrate-max-members.ts",
    "db:migrate-invite-codes": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx api_internal/scripts/migrate-invite-codes.ts",
    "db:optimize-groups": "npx tsx scripts/optimize-existing-groups.ts"
  },
  "dependencies": {
    "@iconscout/react-unicons": "^2.2.5",
    "@opentelemetry/core": "^2.10.0",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.6",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.19.0",
    "caniuse-lite": "^1.0.30001806",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.25.0",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^1.9.1",
    "lucide-react": "^1.33.0",
    "rate-limit-redis": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "sharp": "^0.35.3",
    "vconsole": "^3.15.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/browser-chromium": "^1.62.0",
    "@playwright/browser-webkit": "^1.62.0",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.8.0",
    "hono": "^4.12.32",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "msw": "^2.15.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.49.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1",
    "tar": "7.5.21",
    "minimatch": "^10.0.3",
    "@opentelemetry/core": "$@opentelemetry/core",
    "jwks-rsa": {
      "jose": "5.9.6"
    }
  }
}
