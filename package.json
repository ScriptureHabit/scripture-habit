{
  "name": "scripture-habit",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:pwa": "cross-env VITE_ENABLE_SW_IN_DEV=true vite",
    "dev:all": "node scripts/dev-runner.js",
    "dev:all:seed": "node scripts/dev-runner.js --seed",
    "emulators": "firebase emulators:start --project scripture-habit-auth",
    "server": "npm start --prefix backend",
    "build": "npm run sync:i18n && tsc -b && vite build && npx tsx scripts/localize-meta.ts",
    "lint": "eslint .",
    "sync:i18n": "npx tsx scripts/sync-i18n.ts",
    "check:i18n": "npm run sync:i18n && npx tsx api_internal/scripts/check-i18n.ts",
    "check:unused-i18n": "npx tsx scripts/find-unused-i18n-keys.ts",
    "clean:unused-i18n": "npx tsx scripts/clean-unused-i18n-keys.ts",
    "sort:locales": "npx tsx api_internal/scripts/sort-locales.ts",
    "optimize:images": "npx tsx scripts/optimize-images.ts",
    "check:messages": "npx tsx api_internal/scripts/check-message-types.ts",
    "check:fcm": "npx tsx api_internal/scripts/check-fcm-usage.ts",
    "check:backend": "npx tsx api_internal/scripts/check-backend-integrity.ts",
    "check:knip": "knip",
    "check:lighthouse": "npm run build && npx tsx scripts/run-lighthouse.ts",
    "report:lighthouse": "npx tsx scripts/show-lighthouse-report.ts",
    "check:all": "npm run check:i18n && npm run check:messages && npm run check:fcm && npm run check:backend && npx tsc --noEmit",
    "preview": "vite preview",
    "docs:sync-spec": "node -e \"const fs=require('fs');fs.mkdirSync('docs/public',{recursive:true});fs.copyFileSync('api_internal/openapi.json','docs/public/openapi.json')\"",
    "docs:flow": "node scripts/generate_architecture_tour.js",
    "tour:generate-arch": "node scripts/generate_architecture_tour.js",
    "tour:convert-patterns": "node scripts/convert_tours_to_pattern.js",
    "docs:typedoc": "typedoc",
    "docs:dev": "npm run docs:sync-spec && typedoc && vitepress dev docs",
    "docs:build": "npm run docs:sync-spec && typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest src",
    "test:coverage": "vitest run --coverage",
    "test:rules": "node scripts/test-emulated.js \"npx vitest run --config vitest.rules.config.ts\"",
    "test:internal": "node scripts/test-emulated.js \"npx vitest api_internal --maxWorkers=3 --hookTimeout=30000 --testTimeout=30000\"",
    "test:a11y": "node scripts/test-emulated.js \"npx playwright test tests/accessibility.spec.ts\"",
    "test:e2e": "node scripts/test-emulated.js \"npx playwright test\"",
    "test:e2e:ci": "node scripts/test-emulated.js \"npx playwright test --grep-invert visual\"",
    "test:visual": "node scripts/test-emulated.js \"npx playwright test tests/visual.spec.ts\"",
    "test:visual:update": "node scripts/test-emulated.js \"npx playwright test tests/visual.spec.ts --update-snapshots\"",
    "test:e2e:ui": "node scripts/test-emulated.js \"npx playwright test --ui\"",
    "db:seed": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/seed-existing-user.ts",
    "db:seed:existing": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/seed-existing-user.ts",
    "db:seed:new": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/seed-new-user.ts",
    "db:migrate": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/migrate-data.ts",
    "db:migrate-max-members": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx scripts/migrate-max-members.ts",
    "db:migrate-invite-codes": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npx tsx api_internal/scripts/migrate-invite-codes.ts",
    "db:optimize-groups": "npx tsx scripts/optimize-existing-groups.ts",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "setup:ttl": "npx tsx scripts/setup-ttl.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@iconscout/react-unicons": "^2.2.5",
    "@msgpack/msgpack": "^3.1.3",
    "@opentelemetry/core": "^2.10.0",
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/query-sync-storage-persister": "^5.102.3",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-query-persist-client": "^5.102.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.3",
    "@vercel/speed-insights": "^2.0.0",
    "agentkeepalive": "^4.6.0",
    "axios": "^1.19.0",
    "axios-cache-interceptor": "^1.12.3",
    "axios-retry": "^4.5.0",
    "caniuse-lite": "^1.0.30001809",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.27.0",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.33.0",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "sharp": "^0.35.3",
    "vconsole": "^3.15.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/browser-chromium": "^1.62.1",
    "@playwright/browser-webkit": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "hono": "^4.13.4",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "mermaid": "^11.17.1",
    "msw": "^2.15.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.50.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "11.1.1",
    "tar": "7.5.21",
    "minimatch": "^10.0.3",
    "@opentelemetry/core": "$@opentelemetry/core",
    "jwks-rsa": {
      "jose": "5.9.6"
    },
    "websocket-driver": "^0.7.5",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "extract-zip": "^2.0.1",
    "tmp": "^0.2.3",
    "esbuild": "^0.28.2"
  }
}
