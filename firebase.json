{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json",
        "ttl": [
            {
                "collectionGroup": "translation_cache",
                "field": "createdAt",
                "state": "ENABLED"
            },
            {
                "collectionGroup": "letters",
                "field": "expiresAt",
                "state": "ENABLED"
            },
            {
                "collectionGroup": "recaps",
                "field": "expiresAt",
                "state": "ENABLED"
            }
        ]
    },
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "redirects": [
            {
                "source": "/",
                "destination": "https://scripturehabit.app/",
                "type": 301
            },
            {
                "source": "/:path*",
                "destination": "https://scripturehabit.app/:path",
                "type": 301
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "emulators": {
        "auth": {
            "host": "127.0.0.1",
            "port": 9099,
            "disableWarnings": true,
            "settings": {
                "disableEmailVerification": true
            }
        },
        "firestore": {
            "host": "127.0.0.1",
            "port": 8080
        },
        "hosting": {
            "host": "127.0.0.1",
            "port": 5005
        },
        "ui": {
            "host": "127.0.0.1",
            "enabled": true
        },
        "singleProjectMode": false
    }
}